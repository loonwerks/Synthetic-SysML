{
  "name": "@sysml-viz/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sysml-viz": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"for(const p of ['dist','dist-test'])require('node:fs').rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@sysml-viz/server": "0.1.0"
  }
}
