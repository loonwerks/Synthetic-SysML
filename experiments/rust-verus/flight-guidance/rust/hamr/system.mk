# Do not edit this file as it will be overwritten if HAMR codegen is rerun

MICROKIT_TOOL ?= $(MICROKIT_SDK)/bin/microkit

CFLAGS := -mcpu=$(CPU) \
	-mstrict-align \
	-ffreestanding \
	-nostdlib \
	-g3 \
	-O3 \
	-Wall -Wno-unused-function -Werror -Wno-unused-command-line-argument \
	-I$(MICROKIT_BOARD_DIR)/include \
	-target $(TARGET)

LDFLAGS := -L$(MICROKIT_BOARD_DIR)/lib
LIBS := --start-group -lmicrokit -Tmicrokit.ld --end-group

MSD ?= microkit.system

IMAGES := Flight_Guidance_System_Function_behavior.elf Flight_Guidance_System_Function_behavior_MON.elf pacer.elf
IMAGE_FILE = loader.img
REPORT_FILE = report.txt

UTIL_OBJS = printf.o util.o

TYPES_DIR = $(TOP_DIR)/types
TYPE_OBJS := $(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_Display_FD_Command_1.o $(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_Sync_FD_Command_1.o $(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_Aircraft_Attitude_Data_1.o $(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_AP_Guidance_Request_Data_1.o $(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_AP_Guidance_Data_1.o $(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_FD_Guidance_Data_1.o $(TOP_DIR)/build/sb_queue_bool_1.o

# exporting TOP_TYPES_INCLUDE in case other makefiles need it
export TOP_TYPES_INCLUDE = -I$(TYPES_DIR)/include

TOP_INCLUDE = $(TOP_TYPES_INCLUDE) -I$(TOP_DIR)/util/include

all: $(IMAGE_FILE)
	CHECK_FLAGS_BOARD_MD5:=.board_cflags-$(shell echo -- ${CFLAGS} ${MICROKIT_BOARD} ${MICROKIT_CONFIG}| shasum | sed 's/ *-//')

${CHECK_FLAGS_BOARD_MD5}:
	-rm -f .board_cflags-*
	touch $@

%.o: ${TOP_DIR}/util/src/%.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ -I$(TOP_DIR)/util/include

$(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_Display_FD_Command_1.o: $(TOP_DIR)/types/src/sb_queue_FAA_Flight_Guidance_System_Display_FD_Command_1.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ $(TOP_INCLUDE)


$(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_Sync_FD_Command_1.o: $(TOP_DIR)/types/src/sb_queue_FAA_Flight_Guidance_System_Sync_FD_Command_1.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ $(TOP_INCLUDE)


$(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_Aircraft_Attitude_Data_1.o: $(TOP_DIR)/types/src/sb_queue_FAA_Flight_Guidance_System_Aircraft_Attitude_Data_1.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ $(TOP_INCLUDE)


$(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_AP_Guidance_Request_Data_1.o: $(TOP_DIR)/types/src/sb_queue_FAA_Flight_Guidance_System_AP_Guidance_Request_Data_1.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ $(TOP_INCLUDE)


$(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_AP_Guidance_Data_1.o: $(TOP_DIR)/types/src/sb_queue_FAA_Flight_Guidance_System_AP_Guidance_Data_1.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ $(TOP_INCLUDE)


$(TOP_DIR)/build/sb_queue_FAA_Flight_Guidance_System_FD_Guidance_Data_1.o: $(TOP_DIR)/types/src/sb_queue_FAA_Flight_Guidance_System_FD_Guidance_Data_1.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ $(TOP_INCLUDE)


$(TOP_DIR)/build/sb_queue_bool_1.o: $(TOP_DIR)/types/src/sb_queue_bool_1.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ $(TOP_INCLUDE)


# monitor
Flight_Guidance_System_Function_behavior_MON.o: $(TOP_DIR)/components/Flight_Guidance_System_Function_behavior/src/Flight_Guidance_System_Function_behavior_MON.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ $(TOP_INCLUDE) -I$(TOP_DIR)/components/Flight_Guidance_System_Function_behavior/include

# user code
Flight_Guidance_System_Function_behavior_rust:
	make -C ${CRATES_DIR}/Flight_Guidance_System_Function_behavior $(RUST_MAKE_TARGET)

Flight_Guidance_System_Function_behavior.o: $(TOP_DIR)/components/Flight_Guidance_System_Function_behavior/src/Flight_Guidance_System_Function_behavior.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ $(TOP_INCLUDE) -I$(TOP_DIR)/components/Flight_Guidance_System_Function_behavior/include

pacer.o: $(TOP_DIR)/components/pacer/src/pacer.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ -I$(TOP_INCLUDE)

Flight_Guidance_System_Function_behavior_MON.elf: Flight_Guidance_System_Function_behavior_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

Flight_Guidance_System_Function_behavior.elf: $(UTIL_OBJS) $(TYPE_OBJS) Flight_Guidance_System_Function_behavior_rust Flight_Guidance_System_Function_behavior.o
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/Flight_Guidance_System_Function_behavior/target/aarch64-unknown-none/release $(filter %.o, $^) $(LIBS) -lFlight_Guidance_System_Function_behavior -o $@

pacer.elf: $(UTIL_OBJS) $(TYPE_OBJS) pacer.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

$(IMAGE_FILE): $(IMAGES) $(TOP_DIR)/$(MSD)
	xmllint --xinclude $(TOP_DIR)/$(MSD) | awk 'FNR==1{print; print "<!--"; print "  DO NOT EDIT: This file is generated by merging"; print "    $(TOP_DIR)/$(MSD)"; print "  and its xi:included files."; print "  Modify the source files and run make instead."; print "-->"; next}1' > $(TOP_BUILD_DIR)/$(MSD).merged
	$(MICROKIT_TOOL) $(TOP_BUILD_DIR)/$(MSD).merged --search-path $(TOP_BUILD_DIR) --board $(MICROKIT_BOARD) --config $(MICROKIT_CONFIG) -o $(IMAGE_FILE) -r $(REPORT_FILE)


qemu:
	$(QEMU) -machine virt,virtualization=on \
			-cpu cortex-a53 \
			-serial mon:stdio \
			-device loader,file=$(IMAGE_FILE),addr=0x70000000,cpu-num=0 \
			-m size=2G \
			-nographic

clean::
	rm -f *.o

test:: 
	make -C ${CRATES_DIR}/Flight_Guidance_System_Function_behavior test

clean:: 
	make -C ${CRATES_DIR}/Flight_Guidance_System_Function_behavior clean

verus: 
	make -C ${CRATES_DIR}/Flight_Guidance_System_Function_behavior verus
