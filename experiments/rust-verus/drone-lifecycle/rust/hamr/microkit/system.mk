# Do not edit this file as it will be overwritten if HAMR codegen is rerun

MICROKIT_TOOL ?= $(MICROKIT_SDK)/bin/microkit

CFLAGS := -mcpu=$(CPU) \
	-mstrict-align \
	-ffreestanding \
	-nostdlib \
	-g3 \
	-O3 \
	-Wall -Wno-unused-function -Werror -Wno-unused-command-line-argument \
	-I$(MICROKIT_BOARD_DIR)/include \
	-target $(TARGET)

LDFLAGS := -L$(MICROKIT_BOARD_DIR)/lib
LIBS := --start-group -lmicrokit -Tmicrokit.ld --end-group

MSD ?= microkit.system

IMAGES := request_qualification_process_request_qualification.elf request_qualification_process_request_qualification_MON.elf battery_evidence_assessment_process_battery_evidence_assessment.elf battery_evidence_assessment_process_battery_evidence_assessment_MON.elf lifecycle_governor_process_lifecycle_governor.elf lifecycle_governor_process_lifecycle_governor_MON.elf enablement_derivation_process_enablement_derivation.elf enablement_derivation_process_enablement_derivation_MON.elf pilot_notice_derivation_process_pilot_notice_derivation.elf pilot_notice_derivation_process_pilot_notice_derivation_MON.elf domain_monitor_process_domain_monitor_thread.elf domain_monitor_process_domain_monitor_thread_MON.elf pacer.elf
IMAGE_FILE = loader.img
REPORT_FILE = report.txt

UTIL_OBJS = printf.o util.o

TYPES_DIR = $(TOP_DIR)/types
TYPE_OBJS := $(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Qualified_Request_1.o $(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Lifecycle_Request_Sample_1.o $(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Battery_Evidence_1.o $(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Battery_Sample_1.o $(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Lifecycle_Phase_1.o $(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Decision_Disposition_1.o $(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Charge_Connection_Sample_1.o $(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Lifecycle_Enablement_1.o $(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Pilot_Notice_1.o

# exporting TOP_TYPES_INCLUDE in case other makefiles need it
export TOP_TYPES_INCLUDE = -I$(TYPES_DIR)/include

TOP_INCLUDE = $(TOP_TYPES_INCLUDE) -I$(TOP_DIR)/util/include

all: $(IMAGE_FILE)
	CHECK_FLAGS_BOARD_MD5:=.board_cflags-$(shell echo -- ${CFLAGS} ${MICROKIT_BOARD} ${MICROKIT_CONFIG}| shasum | sed 's/ *-//')

${CHECK_FLAGS_BOARD_MD5}:
	-rm -f .board_cflags-*
	touch $@

%.o: ${TOP_DIR}/util/src/%.c Makefile
	$(CC) -c $(CFLAGS) $< -o $@ -I$(TOP_DIR)/util/include

$(TOP_DIR)/build/sb_queue_Drone_Lifecycle_Governor_Qualified_Request_1.o: $(TOP_DIR)/types/src/sb_queue_Drone_Lifecycle_Governor_Qualified_Request_1.c Makefile
