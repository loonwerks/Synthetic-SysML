# Do not edit this file as it will be overwritten if HAMR codegen is rerun

MICROKIT_TOOL ?= $(MICROKIT_SDK)/bin/microkit

CFLAGS := -mcpu=$(CPU) \
	-mstrict-align \
	-ffreestanding \
	-nostdlib \
	-g3 \
	-O3 \
	-Wall -Wno-unused-function -Werror -Wno-unused-command-line-argument \
	-I$(MICROKIT_BOARD_DIR)/include \
	-target $(TARGET)

LDFLAGS := -L$(MICROKIT_BOARD_DIR)/lib
LIBS := --start-group -lmicrokit -Tmicrokit.ld --end-group

MSD ?= microkit.system

IMAGES := request_priority_behavior.elf request_priority_behavior_MON.elf brake_qualification_behavior.elf brake_qualification_behavior_MON.elf health_qualification_behavior.elf health_qualification_behavior_MON.elf power_qualification_behavior.elf power_qualification_behavior_MON.elf self_test_cycle_behavior.elf self_test_cycle_behavior_MON.elf start_authorization_behavior.elf start_authorization_behavior_MON.elf lifecycle_recovery_behavior.elf lifecycle_recovery_behavior_MON.elf coordinated_outcome_behavior.elf coordinated_outcome_behavior_MON.elf pacer.elf
IMAGE_FILE = loader.img
REPORT_FILE = report.txt

UTIL_OBJS = printf.o util.o

TYPES_DIR = $(TOP_DIR)/types
TYPE_OBJS := $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_RequestFacts_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_RequestLevels_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_BrakeFacts_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_BrakeObservation_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_HealthQualification_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_HealthObservation_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_PowerFacts_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_PowerObservation_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_CycleAssessment_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_SelfTestObservation_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_StartAuthorizationFacts_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_TestCycleDirective_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_AppliedLifecycleSnapshot_1.o $(TOP_DIR)/build/sb_queue_Vehicle_Start_Readiness_Recovery_Supervisor_ControlFrame_1.o

# exporting TOP_TYPES_INCLUDE in case other makefiles need it
export TOP_TYPES_INCLUDE = -I$(TYPES_DIR)/include

TOP_INCLUDE = $(TOP_TYPES_INCLUDE) -I$(TOP_DIR)/util/include

all: $(IMAGE_FILE)
	CHECK_FLAGS_BOARD_MD5:=.board_cflags-$(shell echo -- ${CFLAGS} ${MICROKIT_BOARD} ${MICROKIT_CONFIG}| shasum | sed 's/ *-//')

${CHECK_FLAGS_BOARD_MD5}:
	-rm -f .board_cflags-*
	touch $@

