REPORT_FILE = report.txt

UTIL_OBJS = printf.o util.o

TYPES_DIR = $(TOP_DIR)/types
TYPE_OBJS := $(TOP_DIR)/build/sb_queue_FlightStack_QualifiedFdAndSyncDisposition_1.o $(TOP_DIR)/build/sb_queue_FlightStack_QualifiedApDisposition_1.o $(TOP_DIR)/build/sb_queue_FlightStack_CrewRequests_1.o $(TOP_DIR)/build/sb_queue_FlightStack_QualifiedAttitude_1.o $(TOP_DIR)/build/sb_queue_FlightStack_AircraftAttitude_1.o $(TOP_DIR)/build/sb_queue_FlightStack_ReferenceAndFdState_1.o $(TOP_DIR)/build/sb_queue_FlightStack_PairedFdGuidance_1.o $(TOP_DIR)/build/sb_queue_FlightStack_PairedFcsIndications_1.o $(TOP_DIR)/build/sb_queue_FlightStack_ApGuidanceAndValidity_1.o $(TOP_DIR)/build/sb_queue_FlightStack_ApGuidanceRequestValue_1.o $(TOP_DIR)/build/sb_queue_bool_1.o $(TOP_DIR)/build/sb_queue_FlightStack_PairedApStatus_1.o $(TOP_DIR)/build/sb_queue_FlightStack_ProposedActuatorRates_1.o $(TOP_DIR)/build/sb_queue_FlightStack_ActuatorCommand_1.o

# exporting TOP_TYPES_INCLUDE in case other makefiles need it
export TOP_TYPES_INCLUDE = -I$(TYPES_DIR)/include

TOP_INCLUDE = $(TOP_TYPES_INCLUDE) -I$(TOP_DIR)/util/include

all: $(IMAGE_FILE)
	CHECK_FLAGS_BOARD_MD5:=.board_cflags-$(shell echo -- ${CFLAGS} ${MICROKIT_BOARD} ${MICROKIT_CONFIG}| shasum | sed 's/ *-//')

${CHECK_FLAGS_BOARD_MD5}:
	-rm -f .board_cflags-*
	touch $@

