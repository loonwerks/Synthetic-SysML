// #Sireum

import org.sireum._

val sireum = Os.path(Os.env("SIREUM_HOME").get) / "bin" / (if (Os.isWin) "sireum.bat" else "sireum")

// Do not edit this file as it will be overwritten if HAMR codegen is rerun

// create SlangCheck artifacts for the Slang types used in the project

val files: ISZ[String] = ISZ("../src/main/art/art/DataContent.scala",
                             "../src/main/data/greenhouse_ventilation/Aux_Types.scala",
                             "../src/main/data/greenhouse_ventilation/Base_Types.scala",
                             "../src/main/data/greenhouse_ventilation/Greenhouse_Ventilation/Fan_Command.scala",
                             "../src/main/data/greenhouse_ventilation/Greenhouse_Ventilation/Sensor_Fault_Indication.scala",
                             "../src/main/data/greenhouse_ventilation/Greenhouse_Ventilation/Temperature_Celsius.scala",
                             "../src/main/data/greenhouse_ventilation/Greenhouse_Ventilation/Temperature_Validity.scala",
                             "../src/main/data/greenhouse_ventilation/Greenhouse_Ventilation/Upper_Temperature_Limit.scala",
                             "../src/main/data/greenhouse_ventilation/Greenhouse_Ventilation/Ventilation_Decision_i_control_process_ventilation_decision_Containers.scala",
                             "../src/main/data/greenhouse_ventilation/util/Container.scala",
                             "../src/main/util/greenhouse_ventilation/runtimemonitor/ObservationKind.scala")

val toolargs: String = st"${(files, " ")}".render

(Os.slashDir.up / "src" / "main" / "util" / "greenhouse_ventilation").mkdirAll()

proc"$sireum proyek slangcheck -p greenhouse_ventilation -o ${Os.slashDir.up}/src/main/util/greenhouse_ventilation ${Os.slashDir.up} $toolargs".at(Os.slashDir).console.runCheck()

